DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Either DATABASE_URL or the DB_* values
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tsumi_db
DB_NAME=tsumi_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Must equal JWT_SECRET in apps/backend-node so sockets accept API tokens.
JWT_SIGNING_KEY=change-me-too

# 3000 web, 3002 admin, 3003 customer app, 3004 agent app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Customer app: Paystack returns customers to {FRONTEND_URL}/wallet/topup
FRONTEND_URL=http://localhost:3003

PAYSTACK_SECRET_KEY=

# Business rules (pesewas and basis points)
TSUMI_COMMISSION_BPS=1500
TSUMI_MIN_ERRAND_PRICE_PESEWAS=1000
TSUMI_MAX_ERRAND_PRICE_PESEWAS=500000
TSUMI_MIN_WITHDRAWAL_PESEWAS=1000
TSUMI_MAX_ACTIVE_ERRANDS_PER_AGENT=3
